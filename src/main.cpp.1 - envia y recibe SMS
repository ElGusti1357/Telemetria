#define SIM_PIN ""

// APN (Personal Argentina)
#define NETWORK_APN "datos.personal.com"

// --- SMS ---
#define SMS_DESTINATION "+5491154052645"
#define SMS_TEXT        "Hola Gustavo"

#define TINY_GSM_RX_BUFFER 1024

#define LILYGO_T_A7670

#if defined(LILYGO_T_A7670)
